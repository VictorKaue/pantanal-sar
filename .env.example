# Copy this file to .env and fill in. Never commit .env.

# NASA Earthdata Login (https://urs.earthdata.nasa.gov/users/new)
# Used for NISAR (ASF), MCD64A1 and HLS (LP DAAC).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# FIRMS MAP_KEY (free, by e-mail: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=
