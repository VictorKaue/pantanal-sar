# Secrets
.env
.env.*
!.env.example
.netrc
*.pem
*.key

# Raw and processed data (too large for git; regenerate with the pipeline)
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/**
!data/processed/.gitkeep
*.h5
*.hdf
*.tif
*.tiff
*.nc
*.zip

# Web layers are generated; keep only the folder and an empty manifest
web/data/**
!web/data/.gitkeep
!web/data/manifest.json
!web/data/layers/
!web/data/layers/**
!web/data/series/
!web/data/series/**

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# OS / editors
.DS_Store
.vscode/
.idea/

# Maestri agent workspace
.maestri/

# Synthetic outputs of `cli timeseries --demo` (never published)
data/demo/
